/* 首页：上岗前 5 秒扫完——先看有没有事，再看本岗位新东西。
   一屏一个主角（今天要做），黄色只留给卡里的主按钮。 */

.page { padding-bottom: 24rpx; }

/* ── 顶部：一条状态栏 ── */
.topbar {
  background: linear-gradient(160deg, #0A0E13 0%, #141B24 100%);
  padding: 0 32rpx 64rpx;
  border-radius: 0 0 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tb-left { display: flex; align-items: center; min-width: 0; }
.tb-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #FFC400; margin-right: 12rpx; flex: none;
}
.tb-name {
  font-size: 26rpx; color: #DCE4EC; letter-spacing: 1rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tb-date { font-size: 24rpx; color: #A6B4C1; flex: none; margin-left: 16rpx; }

.body { padding: 0 32rpx; margin-top: -24rpx; }

/* ── 今天要做 ── */
.todo { padding: 8rpx 28rpx 12rpx; }
.todo-head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 24rpx 0 6rpx;
}
.todo-title { font-size: 32rpx; font-weight: 700; color: #10151A; }
.todo-count { font-size: 24rpx; color: #A97900; font-weight: 700; }

.todo-row {
  display: flex; align-items: center;
  padding: 24rpx 0; border-top: 2rpx solid #F1F0EA;
}
.tone { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 18rpx; flex: none; }
.tone-warn { background: #FFC400; }
.tone-danger { background: #D93A3A; }
.tone-info { background: #3B6FE0; }
.todo-text { min-width: 0; }
.todo-main {
  display: block; font-size: 30rpx; font-weight: 700;
  line-height: 42rpx; color: #10151A;
}
.todo-sub {
  display: block; font-size: 26rpx; color: #5A6672;
  line-height: 36rpx; margin-top: 6rpx;
}
.todo-num {
  font-size: 32rpx; font-weight: 700; margin-left: 16rpx; flex: none;
  font-variant-numeric: tabular-nums;
}
.num-warn { color: #A97900; }
.num-danger { color: #D93A3A; }
.num-info { color: #3B6FE0; }

.todo-empty { padding: 16rpx 0 24rpx; border-top: 2rpx solid #F1F0EA; }
.cta {
  margin-top: 22rpx; height: 88rpx; border-radius: 44rpx;
  background: #FFC400; color: #141A21;
  font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center;
}

.arrow { color: #C3CCD8; font-size: 34rpx; margin-left: 12rpx; flex: none; }

/* ── 三个入口：统一样式，不抢主角 ── */
.quick { display: flex; margin: 28rpx 0 4rpx; }
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.quick-ico {
  width: 92rpx; height: 92rpx; border-radius: 28rpx;
  background: #FFFFFF; border: 2rpx solid #E6E5DE;
  display: flex; align-items: center; justify-content: center;
}
.quick-img { width: 44rpx; height: 44rpx; }
.quick-label { font-size: 24rpx; color: #59636E; margin-top: 12rpx; }

/* ── 分节标题 ── */
.sec {
  display: flex; align-items: baseline; justify-content: space-between;
  margin: 40rpx 0 16rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; color: #10151A; }
.sec-more { font-size: 24rpx; color: #5A6672; }

/* ── 本岗位必知 ── */
.list { padding: 2rpx 26rpx; }
.li {
  display: flex; align-items: center;
  padding: 24rpx 0; min-height: 108rpx;
  border-bottom: 2rpx solid #F1F0EA;
}
.li-last { border-bottom: none; }
.li-ico {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; flex: none;
  margin-right: 20rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #59636E; background: #F5F4EE;
}
.li-text { min-width: 0; }
/* 标题最多两行，长标题不再被一个省略号吞掉 */
.li-title {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx; font-weight: 700; line-height: 40rpx; color: #10151A;
}
.li-meta {
  display: block; font-size: 26rpx; color: #5A6672;
  line-height: 34rpx; margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ── 安全文化 ── */
.culture { padding: 26rpx 28rpx; margin-bottom: 16rpx; }
.c-tag {
  display: inline-block; font-size: 22rpx; font-weight: 700;
  color: #A97900; background: #FFF3C4; border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.c-title {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 32rpx; font-weight: 700; line-height: 46rpx; color: #10151A;
  margin-top: 10rpx;
}
.c-body {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx; color: #5A6672; line-height: 42rpx; margin-top: 10rpx;
}

/* ── 学习进度 ── */
.stats { padding: 24rpx 8rpx 26rpx; margin-top: 32rpx; }
.st-head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 0 20rpx 16rpx;
}
.st-title { font-size: 30rpx; font-weight: 700; color: #10151A; }
.st-more { font-size: 24rpx; color: #5A6672; }
.st-row { display: flex; align-items: center; }
.st-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.st-num {
  font-size: 40rpx; font-weight: 700; color: #10151A; line-height: 48rpx;
  font-variant-numeric: tabular-nums;
}
.st-lb { font-size: 22rpx; color: #5A6672; margin-top: 4rpx; }
