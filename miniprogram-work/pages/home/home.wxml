<view class="page">
  <view class="topbar" style="padding-top: {{statusTop}}px">
    <view class="tb-left">
      <text class="tb-dot"></text>
      <text class="tb-name">{{meName}}</text>
    </view>
    <text class="tb-date">{{today}} {{week}}</text>
  </view>

  <view class="body">
    <!-- 今天要做：一屏唯一主角 -->
    <view class="card todo">
      <view class="todo-head">
        <text class="todo-title">今天要做</text>
        <text wx:if="{{todo.length}}" class="todo-count">{{todo.length}} 件</text>
      </view>

      <view wx:for="{{todo}}" wx:key="key" class="todo-row" data-i="{{index}}" bindtap="onTodo">
        <text class="tone tone-{{item.tone}}"></text>
        <view class="grow todo-text">
          <text class="todo-main">{{item.title}}</text>
          <text class="todo-sub">{{item.sub}}</text>
        </view>
        <text class="todo-num num-{{item.tone}}">{{item.num}}</text>
      </view>

      <view wx:if="{{!todo.length && !loading}}" class="todo-empty">
        <text class="todo-main">今天没有待办</text>
        <text class="todo-sub">暂没有待办和到期学习任务</text>
        <view class="cta" bindtap="goLearn">去学一条规程</view>
      </view>
      <view wx:if="{{loading}}" class="todo-empty">
        <text class="todo-sub">正在加载…</text>
      </view>
    </view>

    <!-- 三个入口：统一样式，不抢主角 -->
    <view class="quick">
      <view class="quick-item" wx:for="{{quick}}" wx:key="name" data-i="{{index}}" bindtap="onQuick">
        <view class="quick-ico">
          <image class="quick-img" src="/images/{{item.icon}}.png" />
        </view>
        <text class="quick-label">{{item.name}}</text>
      </view>
    </view>

    <!-- 本岗位必知 -->
    <block wx:if="{{medias.length}}">
      <view class="sec">
        <text class="sec-title">本岗位必知</text>
        <text class="sec-more" bindtap="toMedia">全部 ›</text>
      </view>
      <view class="card list">
        <view
          wx:for="{{medias}}"
          wx:key="id"
          class="li {{index === medias.length - 1 ? 'li-last' : ''}}"
          data-id="{{item.id}}"
          bindtap="openMedia"
        >
          <view class="li-ico">{{item.icon}}</view>
          <view class="grow li-text">
            <text class="li-title">{{item.title}}</text>
            <text class="li-meta">{{item.cat}}{{item.dateText ? ' · ' + item.dateText : ''}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </block>

    <!-- 安全文化 -->
    <block wx:if="{{cultures.length}}">
      <view class="sec">
        <text class="sec-title">安全文化</text>
        <text class="sec-more" bindtap="toCulture">更多 ›</text>
      </view>
      <view wx:for="{{cultures}}" wx:key="id" class="card culture" data-id="{{item.id}}" bindtap="openCulture">
        <text wx:if="{{item.tag}}" class="c-tag">{{item.tag}}</text>
        <text class="c-title">{{item.title}}</text>
        <text wx:if="{{item.body}}" class="c-body">{{item.body}}</text>
      </view>
    </block>

    <!-- 学习进度：一行看完，点击进学习页 -->
    <view class="card stats" bindtap="goLearn">
      <view class="st-head">
        <text class="st-title">我的学习</text>
        <text class="st-more">去学习 ›</text>
      </view>
      <view class="st-row">
        <view class="st-item">
          <text class="st-num">{{summary.hours || 0}}</text>
          <text class="st-lb">学时 / {{summary.targetHours || 72}}</text>
        </view>
        <view class="st-item">
          <text class="st-num">{{summary.readCount || 0}}</text>
          <text class="st-lb">已学内容</text>
        </view>
        <view class="st-item">
          <text class="st-num">{{summary.quiz.attempts || 0}}</text>
          <text class="st-lb">答题次数</text>
        </view>
        <view class="st-item">
          <text class="st-num">{{summary.issue.pending || 0}}</text>
          <text class="st-lb">待办问题</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tabbar-space"></view>
  <tabbar active="0" />
</view>
