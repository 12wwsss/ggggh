.page { background: #F3F2ED; min-height: 100vh; }

.hero {
  padding: 44rpx 32rpx 50rpx;
  color: #fff;
}
.hero-case { background: linear-gradient(150deg, #8A5A00, #2A1C00); }
.hero-month { background: linear-gradient(150deg, #2E6BE6, #12395B); }
.hero-word { background: linear-gradient(150deg, #12B76A, #0B6B45); }
.hero-star { background: linear-gradient(150deg, #F79009, #B45309); }
.hero-card { background: linear-gradient(150deg, #7C5CFF, #3B2A8C); }

.hero-cat {
  font-size: 21rpx; font-weight: 700;
  background: rgba(255,255,255,.22);
  padding: 6rpx 18rpx; border-radius: 20rpx;
}
.hero-title { font-size: 42rpx; font-weight: 700; line-height: 60rpx; margin-top: 22rpx; }
.hero-meta { font-size: 22rpx; color: rgba(255,255,255,.75); margin-top: 16rpx; }

.wrap { padding: 0 32rpx; }
.body {
  margin-top: -26rpx;
  padding: 36rpx 32rpx;
}
.para {
  font-size: 29rpx; line-height: 52rpx; color: #242B32;
  margin-bottom: 26rpx;
}
.src {
  font-size: 24rpx; color: #6F7B87; line-height: 36rpx;
  padding-top: 18rpx; border-top: 2rpx solid #F2F5F8;
}

.gap { margin-top: 32rpx; align-items: stretch; }
/* 问问 AI 始终占满剩余宽度；只有存在配套题目时才显示左侧按钮 */
.btn-next { flex: 1; margin-left: 20rpx; }
.btn-solo { flex: 1; }
.btn-ghost {
  height: 96rpx; border-radius: 48rpx;
  background: #fff; border: 2rpx solid #E6E5DE;
  color: #59636E; font-size: 27rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 0 28rpx;
}

.tip { text-align: center; color: #98A2AC; font-size: 24rpx; padding: 80rpx 0; }
.err { padding: 32rpx; margin-top: 40rpx; }
.retry {
  display: inline-block; margin-top: 20rpx;
  background: #FFC400; color: #141A21; font-size: 24rpx;
  padding: 12rpx 32rpx; border-radius: 28rpx;
}
.bottom-space { height: 60rpx; }
