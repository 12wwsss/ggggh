.page { background: #F3F2ED; min-height: 100vh; padding-bottom: 40rpx; }

.cats {
  white-space: nowrap;
  padding: 20rpx 24rpx 4rpx;
  background: #fff;
  border-bottom: 2rpx solid #ECEBE4;
}
.cat {
  display: inline-block;
  font-size: 26rpx;
  color: #59636E;
  padding: 12rpx 26rpx;
  border-radius: 30rpx;
  background: #F3F2ED;
  margin-right: 14rpx;
}
.cat-on { background: #FFC400; color: #141A21; font-weight: 700; }

.wrap { padding: 24rpx 32rpx; }

.item { display: flex; padding: 24rpx; margin-bottom: 20rpx; }

.cover {
  width: 150rpx; height: 150rpx; border-radius: 20rpx;
  margin-right: 22rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
}
.cover-txt { font-size: 22rpx; font-weight: 700; color: #fff; }
.cover-case { background: linear-gradient(140deg, #8A5A00, #2A1C00); }
.cover-month { background: linear-gradient(140deg, #2E6BE6, #1B4F8A); }
.cover-word { background: linear-gradient(140deg, #12B76A, #0B8A50); }
.cover-star { background: linear-gradient(140deg, #F79009, #D97706); }
.cover-card { background: linear-gradient(140deg, #7C5CFF, #4C34B8); }

.title { font-size: 29rpx; font-weight: 700; line-height: 42rpx; }
.summary {
  font-size: 23rpx; color: #7C8B99; line-height: 34rpx; margin-top: 10rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.meta { font-size: 21rpx; color: #A8B2BC; margin-top: 12rpx; }
.dot { margin: 0 8rpx; }

.tip { text-align: center; color: #98A2AC; font-size: 24rpx; padding: 60rpx 0; }

.err { padding: 32rpx; }
.retry {
  display: inline-block; margin-top: 20rpx;
  background: #FFC400; color: #141A21; font-size: 24rpx;
  padding: 12rpx 32rpx; border-radius: 28rpx;
}
