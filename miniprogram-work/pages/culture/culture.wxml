<view class="page">
  <scroll-view class="cats" scroll-x enable-flex>
    <view class="cat {{cat === '' ? 'cat-on' : ''}}" data-c="" bindtap="pickCat">全部</view>
    <view class="cat {{cat === item ? 'cat-on' : ''}}" wx:for="{{cats}}" wx:key="*this"
          data-c="{{item}}" bindtap="pickCat">{{item}}</view>
  </scroll-view>

  <view class="wrap">
    <!-- 骨架：等接口时先显示三张灰卡，比一行“正在加载”稳 -->
    <block wx:if="{{loading}}">
      <view class="card item" wx:for="{{skeleton}}" wx:key="*this">
        <view class="cover sk-cover"></view>
        <view class="grow">
          <view class="sk-line" style="width: 70%"></view>
          <view class="sk-line" style="width: 92%"></view>
          <view class="sk-line" style="width: 55%"></view>
        </view>
      </view>
    </block>

    <view wx:if="{{err}}" class="card err">
      <text class="err-main">内容没加载出来</text>
      <text class="err-sub">{{err}}</text>
      <view class="retry" bindtap="retry">重试</view>
    </view>

    <block wx:if="{{!loading && !err}}">
      <view class="card item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <view class="cover cover-{{item.cover}}">
          <text class="cover-txt">{{item.cat}}</text>
        </view>
        <view class="grow">
          <view class="title">{{item.title}}</view>
          <view class="summary">{{item.summary}}</view>
          <view wx:if="{{item.date}}" class="meta">{{item.date}}{{item.minutes ? ' · 阅读约 ' + item.minutes + ' 分钟' : ''}}</view>
        </view>
      </view>

      <view wx:if="{{!items.length}}" class="empty">
        <text class="empty-main">这个分类还没有内容</text>
        <text class="empty-sub">安全科在后台「安全文化内容」发布后会出现在这里</text>
      </view>
    </block>
  </view>
</view>
