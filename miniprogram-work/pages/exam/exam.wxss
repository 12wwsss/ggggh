.page { background: #F3F2ED; min-height: 100vh; padding-bottom: 40rpx; }
.wrap { padding: 24rpx 32rpx; }

.tip { text-align: center; color: #98A2AC; font-size: 24rpx; padding: 60rpx 0; }
.err { padding: 30rpx; }
.retry {
  display: inline-block; margin-top: 18rpx;
  background: #FFC400; color: #141A21; font-size: 24rpx;
  padding: 12rpx 32rpx; border-radius: 28rpx;
}

/* 列表 */
.ex { padding: 28rpx; margin-bottom: 18rpx; }
.ex-title { font-size: 29rpx; font-weight: 700; line-height: 42rpx; flex: 1; margin-right: 16rpx; }
.ex-score { font-size: 52rpx; font-weight: 700; line-height: 56rpx; }
.ex-score.ok { color: #12B76A; }
.ex-score.bad { color: #E5484D; }
.lock {
  margin-top: 18rpx; text-align: center; font-size: 24rpx; color: #98A2AC;
  background: #F2F5F9; border-radius: 30rpx; padding: 14rpx 0;
}
.tag { font-size: 20rpx; font-weight: 700; padding: 6rpx 16rpx; border-radius: 18rpx; flex: none; }
.tag.g { color: #12B76A; background: #E7F8F0; }
.tag.r { color: #E5484D; background: #FDECEC; }
.tag.y { color: #F79009; background: #FFF6E5; }
.tag.n { color: #98A2AC; background: #EFEEE7; }

/* 我的岗位 */
.myjob { margin: 8rpx 4rpx 18rpx; }
.wrap-chips { flex-wrap: wrap; }
.wrap-chips .chip { margin: 0 14rpx 14rpx 0; height: 58rpx; padding: 0 26rpx; font-size: 24rpx; }

/* 考试中 */
.bar { background: #fff; padding: 20rpx 32rpx; border-bottom: 2rpx solid #ECEBE4; }
.timer { font-size: 26rpx; font-weight: 700; color: #A97900; }
.timer.danger { color: #E5484D; }
.prog { height: 8rpx; background: #ECEBE4; border-radius: 4rpx; margin-top: 14rpx; overflow: hidden; }
.prog-in { height: 8rpx; background: #FFC400; border-radius: 4rpx; }

.q-card { padding: 32rpx; margin-top: 8rpx; }
.q-text { font-size: 31rpx; font-weight: 700; line-height: 46rpx; }
.opt {
  display: flex; align-items: center;
  margin-top: 20rpx; padding: 26rpx 24rpx;
  border: 2rpx solid #E6E5DE; border-radius: 20rpx; background: #fff;
}
.opt-key {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #F2F5F9; color: #59636E;
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 18rpx; flex: none;
}
.opt-text { font-size: 27rpx; line-height: 40rpx; flex: 1; }
.opt-on { border-color: #A97900; background: #FFF9E6; }
.opt-on .opt-key { background: #FFC400; color: #141A21; }

.btn-ghost {
  height: 96rpx; border-radius: 48rpx;
  background: #fff; border: 2rpx solid #E6E5DE;
  color: #59636E; font-size: 27rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 0 40rpx;
}

/* 成绩 */
.score-card { padding: 36rpx 32rpx; }
.big-score { font-size: 96rpx; font-weight: 700; line-height: 100rpx; }
.big-score.ok { color: #12B76A; }
.big-score.bad { color: #E5484D; }
.label { font-size: 22rpx; color: #98A2AC; font-weight: 700; margin: 32rpx 0 14rpx; }
.dt { padding: 24rpx 26rpx; margin-bottom: 14rpx; }
.dt-idx {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  font-size: 20rpx; font-weight: 700; color: #fff;
  display: flex; align-items: center; justify-content: center;
  margin-right: 12rpx; flex: none;
}
.dt-idx.ok { background: #12B76A; }
.dt-idx.bad { background: #E5484D; }
.dt-q { font-size: 25rpx; font-weight: 700; line-height: 38rpx; flex: 1; }

.quick-card {
  padding: 26rpx 28rpx; margin-bottom: 16rpx;
  display: flex; align-items: center;
}
