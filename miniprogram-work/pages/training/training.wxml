<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <view wx:if="{{err}}" class="wrap">
    <view class="card err">
      <view class="small bold" style="color:#E5484D">带培计划没加载出来</view>
      <view class="tiny muted" style="margin-top:8rpx">{{err}}</view>
      <text class="retry" bindtap="retry">重试</text>
    </view>
  </view>

  <view wx:if="{{!plan && !loading && !err}}" class="wrap">
    <view class="card empty-plan">
      <view class="small bold">还没有带培计划</view>
      <view class="tiny muted" style="margin-top:10rpx;line-height:1.9">
        新员工入矿、转岗或复训时，由培训员/区队长在电脑端后台建计划并指定带培师傅；
        建好后这里会显示每周的阶段任务、完成进度和师傅小结。
      </view>
      <view class="row gap" style="margin-top:24rpx">
        <view class="btn-ghost" bindtap="toQuiz">先练题</view>
        <view class="btn-primary" style="flex:1;margin-left:20rpx" bindtap="toChat">问 AI</view>
      </view>
    </view>
  </view>

  <block wx:if="{{plan}}">
    <view class="head">
      <view class="head-kicker">新员工带培 · 共 {{plan.totalWeeks}} 周</view>
      <view class="head-title">{{plan.title}}</view>
      <view wx:if="{{plan.asMentor}}" class="head-sub">学员：{{plan.userName}}<text wx:if="{{plan.deptName}}"> · {{plan.deptName}}</text></view>
      <view class="bar"><view class="bar-in" style="width: {{progress}}%"></view></view>
      <view class="row between" style="margin-top: 12rpx">
        <text class="tiny" style="color:#8FA3B8">目标：{{plan.target}}</text>
        <text class="tiny" style="color:#FFD3C0">已完成 {{progress}}%</text>
      </view>
    </view>

    <view class="wrap">
      <view wx:if="{{labels.length > 1}}" class="card plan-pick">
        <text class="tiny muted">带培对象</text>
        <picker range="{{labels}}" value="{{planIndex}}" bindchange="onPlanChange">
          <view class="pick-row">{{labels[planIndex]}} ▾</view>
        </picker>
      </view>

      <view class="label">阶段进度</view>
      <view class="card stages">
        <view class="stage" wx:for="{{plan.stages}}" wx:key="name">
          <view class="stage-left">
            <view class="node {{item.done ? 'node-done' : ''}}">{{item.done ? '✓' : index + 1}}</view>
            <view class="line" wx:if="{{index < plan.stages.length - 1}}"></view>
          </view>
          <view class="grow">
            <view class="row between">
              <text class="stage-name">{{item.goal}}</text>
              <text class="stage-week">{{item.name}}</text>
            </view>
            <view class="task" wx:for="{{item.tasks}}" wx:for-item="t" wx:key="*this">· {{t}}</view>
            <view
              wx:if="{{canWrite}}"
              class="stage-act {{item.done ? 'stage-act-off' : ''}}"
              data-id="{{item.id}}"
              data-done="{{item.done}}"
              catchtap="toggleStage"
            >{{item.done ? '撤销完成' : '确认完成'}}</view>
          </view>
        </view>
      </view>

      <view class="label">薄弱点（来自答题与训练）</view>
      <view class="card weak" wx:for="{{plan.weakPoints}}" wx:key="title">
        <view class="grow">
          <view class="small bold">{{item.title}}</view>
          <view class="tiny muted" style="margin-top:6rpx">{{item.from}}</view>
        </view>
        <text class="link" bindtap="toRisk">去复习 ›</text>
      </view>

      <view class="card mentor">
        <view class="tiny muted bold">带培师傅</view>
        <view class="small" style="margin-top:10rpx">{{plan.mentor}}</view>
      </view>

      <view class="label">师傅小结</view>

      <view wx:if="{{canWrite}}" class="card note-form">
        <view class="row between note-head">
          <picker range="{{kinds}}" value="{{kindIndex}}" bindchange="onKindChange">
            <view class="pick">{{kinds[kindIndex]}} ▾</view>
          </picker>
          <input class="period" value="{{period}}" bindinput="onPeriod" placeholder="2026-11" />
        </view>
        <textarea
          class="note-input"
          value="{{content}}"
          bindinput="onContent"
          maxlength="600"
          placeholder="本月跟班情况、掌握的技能、存在的问题与下月重点（至少 10 字）"
        />
        <view class="btn-note" bindtap="saveNote">{{saving ? '保存中…' : '提交小结'}}</view>
      </view>

      <view wx:if="{{!notes.length}}" class="card note-empty">
        <text class="tiny muted">{{canWrite ? '还没有小结，写一条吧' : '师傅还没有提交小结'}}</text>
      </view>

      <view wx:for="{{notes}}" wx:key="id" class="card note-item">
        <view class="row between">
          <text class="note-meta">{{item.period}} · {{item.kind === 'final' ? '期满总结' : '月度小结'}} · {{item.author}}</text>
          <text class="tiny muted">{{item.at}}</text>
        </view>
        <view class="note-body">{{item.content}}</view>
      </view>

      <view class="row gap">
        <view class="btn-ghost" bindtap="toQuiz">去练题</view>
        <view class="btn-primary" style="flex:1;margin-left:20rpx" bindtap="toChat">模拟问答</view>
      </view>
      <view class="bottom-space"></view>
    </view>
  </block>
</view>
