<view class="page">
  <view class="wrap">
    <view class="head">
      <view class="h-title">设置新口令</view>
      <view class="tiny muted" style="margin-top:8rpx">首次登录需要修改管理员分配的初始口令</view>
    </view>

    <view class="card">
      <view class="label">新口令（至少 8 位）</view>
      <input class="ipt" password placeholder="输入新口令" bindinput="onP1" value="{{p1}}" />
      <view class="label" style="margin-top:20rpx">确认新口令</view>
      <input class="ipt" password placeholder="再输入一次" bindinput="onP2" value="{{p2}}" />
      <view wx:if="{{err}}" class="tiny" style="color:#E5484D;margin-top:14rpx">{{err}}</view>
      <view class="btn-primary" style="margin-top:28rpx" bindtap="submit">{{loading ? '保存中…' : '保存并进入'}}</view>
    </view>
  </view>
</view>
