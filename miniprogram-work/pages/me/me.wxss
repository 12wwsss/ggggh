.head {
  background: linear-gradient(160deg, #10151A 0%, #1B2E45 100%);
  padding: 0 32rpx 90rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: #24374D; color: #9FB2C6;
  font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.name { color: #fff; font-size: 34rpx; font-weight: 700;
  max-width: 330rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.id { color: #8FA3B8; font-size: 22rpx; margin-top: 8rpx; }

.stats { margin-top: 34rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-v { color: #fff; font-size: 38rpx; font-weight: 700; }
.stat-l { color: #8FA3B8; font-size: 20rpx; margin-top: 8rpx; }

.menu { margin-top: 0; padding: 10rpx 28rpx; }
.m-item { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 2rpx solid #F2F5F8; }
.m-item:last-child { border-bottom: none; }
.m-ico {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; margin-right: 20rpx; flex: none;
}
.arrow { color: #B7C2CE; font-size: 32rpx; }

/* 安全科电话 */
.contact { padding: 26rpx 28rpx; margin-top: 20rpx; }
.c-ico {
  width: 76rpx; height: 76rpx; border-radius: 20rpx; flex: none;
  background: #FFF3C4; color: #A97900;
  font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
}
.c-call { color: #A97900; font-size: 25rpx; font-weight: 700; }

.remind { margin-top: 20rpx; padding: 28rpx; background: #FFF8F3; }
.points { margin-top: 20rpx; padding: 28rpx; }
.p-v { font-size: 46rpx; font-weight: 700; color: #A97900; line-height: 50rpx; }


.score { padding: 28rpx; margin-bottom: 20rpx; }
.stats-row { margin-top: 22rpx; }
.s-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.s-num { font-size: 40rpx; font-weight: 700; color: #10151A; line-height: 48rpx; }
.s-num.ok { color: #12B76A; }
.s-num.bad { color: #E5484D; }
.s-lb { font-size: 20rpx; color: #98A2AC; margin-top: 6rpx; }
.team-line {
  margin-top: 22rpx; padding-top: 18rpx;
  border-top: 2rpx solid #F2F5F8;
  font-size: 22rpx; color: #7C8B99;
}

.wrap { margin-top: -56rpx; }

/* 头像：微信 chooseAvatar 按钮 */
.avatar-btn { position: relative; width: 128rpx; height: 128rpx; flex: none;
  padding: 0; margin: 0; background: transparent; border: none; line-height: 1; overflow: visible; }
.avatar-btn::after { border: none; }
.avatar-img { width: 128rpx; height: 128rpx; border-radius: 50%; display: block; background: #24374D; }
.avatar-edit {
  position: absolute; right: -6rpx; bottom: -6rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #FFC400; color: #141A21; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  border: 4rpx solid #10151A;
}
/* 未绑定微信时的入口 */
.bind-wx {
  display: inline-block; margin-top: 12rpx;
  padding: 6rpx 18rpx; border-radius: 22rpx;
  background: rgba(255,196,0,.16); color: #FFC400;
  font-size: 21rpx; font-weight: 700;
}
.edit-name {
  margin-left: 12rpx; font-size: 20rpx; font-weight: 400;
  color: #FFC400; opacity: .85;
}
.edit-link {
  display: inline-block; margin-top: 12rpx;
  font-size: 21rpx; color: #8FA3B8;
}
/* 头部内容避开右上角胶囊，给名字留出宽度 */
.head .row:first-child { padding-right: 150rpx; }

/* 名字和「改名」贴在一行，紧挨头像 */
.name-row { display: flex; align-items: baseline; }
.name-row .name { max-width: 260rpx; }
.name-row .edit-link { margin-left: 14rpx; margin-top: 0; font-size: 21rpx; color: #8FA3B8; }
/* 身份行：头像和名字紧贴，左对齐 */
.idrow { display: flex; align-items: center; justify-content: flex-start; }
.idbox { flex: 1; min-width: 0; margin-left: 16rpx; }
.avatar-btn { flex: 0 0 112rpx; width: 112rpx; height: 112rpx; }
.avatar-img, .avatar { width: 112rpx; height: 112rpx; }