<view class="page">
  <view class="tabs">
    <text class="tab {{tab === index ? 'tab-on' : ''}}" wx:for="{{tabs}}" wx:key="*this"
          data-i="{{index}}" bindtap="pickTab">{{item}}</text>
  </view>

  <view class="wrap">
    <view wx:if="{{loading}}" class="tip">加载中…</view>

    <view wx:if="{{err}}" class="card err">
      <view class="small bold" style="color:#E5484D">工单没加载出来</view>
      <view class="tiny muted" style="margin-top:8rpx">{{err}}</view>
      <text class="retry" bindtap="retry">重试</text>
    </view>

    <block wx:if="{{!loading && !err}}">
      <view class="card item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="toggle">
        <view class="row between">
          <view class="row">
            <text class="type">{{item.type}}</text>
            <text wx:if="{{item.urgent}}" class="urgent">紧急</text>
          </view>
          <text class="st st-{{item.stCls}}">{{item.status_text || item.status}}</text>
        </view>

        <view class="title">{{item.title}}</view>
        <view class="meta">{{item.code || item.id}} · {{item.loc}} · {{item.reporter}}</view>

        <view wx:if="{{item.handleNote}}" class="done">
          处置：{{item.handleNote}}（{{item.handler}}）
        </view>

        <view wx:if="{{open === item.id && flows[item.id].length}}" class="done">
          <view wx:for="{{flows[item.id]}}" wx:for-item="f" wx:key="id" style="margin-bottom:8rpx">
            <text class="tiny bold">{{f.text}}</text>
            <text class="tiny muted"> · {{f.actor || '—'}} · {{f.atText}}</text>
            <view wx:if="{{f.comment}}" class="tiny muted">{{f.comment}}</view>
          </view>
        </view>

        <view wx:if="{{open === item.id && item.photos.length}}" class="photos-row">
          <image wx:for="{{item.photos}}" wx:for-item="p" wx:key="*this" src="{{p}}" mode="aspectFill"
                 class="ph-img" data-src="{{p}}" bindtap="previewPhoto" />
        </view>

        <view wx:if="{{open === item.id && item.raw_status === 'reported'}}" class="picker-row">
          <text class="tiny muted">整改人</text>
          <picker range="{{staffNames}}" value="{{staffIdx}}" bindchange="onAssignee">
            <view class="picker-val">{{staffNames[staffIdx] || '选择整改人'}} ›</view>
          </picker>
        </view>

        <view wx:if="{{open === item.id && item.canAct}}" class="form">
          <textarea class="ta" placeholder="写清处置说明；验收请写验收意见"
                    placeholder-class="ph" maxlength="300" bindinput="onNote" value="{{note}}" />
          <view class="btn-mini" data-id="{{item.id}}" catchtap="submit">{{item.actText}}</view>
        </view>
      </view>

      <view wx:if="{{!items.length}}" class="tip">没有待处理的工单</view>
    </block>
  </view>
</view>
