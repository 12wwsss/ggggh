.label { font-size: 22rpx; color: #98A2AC; font-weight: 700; margin: 30rpx 0 16rpx; }
.types { flex-wrap: wrap; }
.types .chip { margin-right: 16rpx; height: 62rpx; padding: 0 26rpx; font-size: 24rpx; }

.desc { padding: 28rpx; margin-top: 8rpx; }
.ta { width: 100%; height: 130rpx; font-size: 26rpx; line-height: 40rpx; }
.ph { color: #98A6B4; }

.photos { margin-top: 4rpx; }
.photo {
  width: 152rpx; height: 152rpx; border-radius: 22rpx;
  border: 2rpx dashed #C6D2DE; color: #C6D2DE;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-right: 20rpx;
}
.photo-on { background: #E8EDF3; border-style: solid; border-color: #E8EDF3; color: #8C9BAA; }

.loc { margin-top: 24rpx; padding: 24rpx 28rpx; display: flex; align-items: center; }
.pin { color: #A97900; font-size: 30rpx; margin-right: 18rpx; }

.seg {
  width: 152rpx; height: 64rpx; border-radius: 16rpx;
  background: #fff; border: 2rpx solid #E6E5DE; color: #59636E;
  font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 18rpx;
}
.seg-on { background: #FFF3C4; border-color: #A97900; color: #A97900; font-weight: 700; }

.bottom-space { height: 80rpx; }


.rec { padding: 24rpx 26rpx; margin-top: 16rpx; }
.rec-id { font-size: 21rpx; color: #A8B2BC; }
.rec-title { font-size: 27rpx; font-weight: 700; margin-top: 10rpx; line-height: 40rpx; }
.rec-st { font-size: 21rpx; font-weight: 700; }
.st-pending { color: #E5484D; }
.st-closed { color: #12B76A; }
.rec-note {
  margin-top: 14rpx; padding: 14rpx 18rpx;
  background: #F2FBF7; border-radius: 12rpx;
  font-size: 22rpx; color: #12B76A; line-height: 34rpx;
}

.photo-wrap { position: relative; width: 150rpx; height: 150rpx; margin: 0 14rpx 14rpx 0; }
.photo-img { width: 150rpx; height: 150rpx; border-radius: 16rpx; background: #ECEBE4; }
.photo-del {
  position: absolute; top: -8rpx; right: -8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #E5484D; color: #fff; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.ph-add { display: flex; align-items: center; justify-content: center; }
.loc-ipt { font-size: 26rpx; color: #10151A; height: 44rpx; }
.rec { padding: 24rpx 26rpx; margin-bottom: 14rpx; }

/* 语音上报 */
.voice-row { align-items: center; margin-bottom: 6rpx; }
.voice-btn {
  padding: 20rpx 36rpx; border-radius: 44rpx;
  background: #FFF3C4; color: #A97900;
  font-size: 26rpx; font-weight: 700;
}
.voice-rec { background: #FFC400; color: #141A21; }
.audio-chip {
  display: inline-flex; align-items: center;
  margin-top: 10rpx; padding: 12rpx 22rpx;
  background: #EAF4FF; border-radius: 30rpx;
}
.audio-play { font-size: 24rpx; color: #2E6BE6; }
.audio-del { margin-left: 22rpx; font-size: 30rpx; color: #98A2AC; }
.voice-modes { display: flex; margin-left: 18rpx; border: 2rpx solid #E6E5DE; border-radius: 30rpx; overflow: hidden; }
.vm { padding: 10rpx 24rpx; font-size: 23rpx; color: #7C8B99; }
.vm-on { background: #FFC400; color: #141A21; font-weight: 700; }
.rec-audio {
  display: inline-block; margin-top: 10rpx; padding: 10rpx 20rpx;
  background: #EAF4FF; color: #2E6BE6; font-size: 23rpx; border-radius: 24rpx;
}
/* 按钮放右侧，方便单手拇指按；细节：占满剩余宽度 */
.voice-row { justify-content: space-between; }
.voice-btn { flex: 1; margin-left: 18rpx; text-align: center; }
.tabs { display: flex; gap: 16rpx; margin: 18rpx 0 6rpx; }
.tab { font-size: 26rpx; color: #59636E; padding: 10rpx 26rpx; background: #EEF1F5; border-radius: 28rpx; }
.tab-on { background: #FFC400; color: #141A21; font-weight: 700; }
.tag-assigned { font-size: 20rpx; color: #2E6BE6; background: #EAF0FD; border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 10rpx; font-weight: 400; }
.btn-mini { display: inline-block; background: #FFC400; color: #141A21; font-size: 26rpx; font-weight: 700; padding: 12rpx 32rpx; border-radius: 999rpx; }