<view class="page">
  <view class="wrap">
    <view class="head">
      <view class="h-title">待办</view>
      <view class="tiny muted" style="margin-top:6rpx">共 {{total}} 件</view>
    </view>

    <view wx:if="{{loading}}" class="card center muted">加载中…</view>
    <view wx:elif="{{err}}" class="card center">
      <view class="small bold" style="color:#E5484D">{{err}}</view>
      <view class="retry" bindtap="load">重试</view>
    </view>
    <view wx:elif="{{!items.length}}" class="card center muted">暂无待办</view>

    <view wx:for="{{items}}" wx:key="key" class="card row-item" data-key="{{item.key}}" bindtap="open">
      <view class="left">
        <view class="small bold">{{item.label}}</view>
        <view class="tiny muted" style="margin-top:4rpx">{{item.count}} 件待处理</view>
      </view>
      <text class="count">{{item.count}}</text>
    </view>
  </view>
</view>
