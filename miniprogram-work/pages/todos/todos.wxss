.page { background: #F5F6F8; min-height: 100vh; }
.wrap { padding: 32rpx; }
.head { margin-bottom: 24rpx; }
.h-title { font-size: 40rpx; font-weight: 700; color: #1D1A15; }
.card { background: #fff; border-radius: 18rpx; padding: 28rpx; margin-bottom: 18rpx; }
.center { text-align: center; padding: 48rpx 0; }
.retry { color: #C0392B; margin-top: 12rpx; font-size: 27rpx; }
.row-item { display: flex; align-items: center; justify-content: space-between; }
.left { flex: 1; }
.count { color: #C0392B; font-size: 40rpx; font-weight: 700; }
