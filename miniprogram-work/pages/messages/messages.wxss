.page { background: #F5F6F8; min-height: 100vh; }
.wrap { padding: 24rpx 28rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 26rpx 28rpx; margin-bottom: 18rpx; }
.head-card { margin-bottom: 22rpx; }
.big { font-size: 40rpx; font-weight: 700; }
.link { color: #2E6BE6; font-size: 26rpx; font-weight: 700; }
.m-item { position: relative; }
.m-item.unread { background: #FFFDF5; }
.m-title { font-size: 28rpx; font-weight: 700; color: #1D1A15; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #E5484D; margin-right: 12rpx; }
.retry { color: #2E6BE6; font-size: 26rpx; }

.tabs { display: flex; gap: 14rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.tab { font-size: 25rpx; color: #59636E; background: #fff; padding: 8rpx 22rpx; border-radius: 999rpx; }
.tab-on { background: #FFC400; color: #141A21; font-weight: 700; }