<view class="page">
  <view class="brand">
    <view class="logo">安</view>
    <view class="title">煤矿安全智能体</view>
    <view class="sub">问答 · 学习 · 考试 · 隐患上报</view>
  </view>

  <view class="panel">
    <view class="benefit">
      <view class="b-item"><text class="dot"></text>用工号登录，学习、考试、隐患记录跟人走</view>
      <view class="b-item"><text class="dot"></text>不收集手机号、位置、通讯录</view>
      <view class="b-item"><text class="dot"></text>一次登录，以后打开自动进入</view>
    </view>

    <input class="inp" placeholder="工号" value="{{username}}" bindinput="onUser" />
    <input class="inp" placeholder="口令" password="{{true}}" value="{{password}}" bindinput="onPwd" />

    <button class="wx-login" loading="{{loading}}" bindtap="login">登录</button>

    <view wx:if="{{err}}" class="err">{{err}}</view>
    <view wx:if="{{tip}}" class="tip">{{tip}}</view>

    <view class="local" bindtap="useLocal">先以本机模式进入 ›</view>
    <view class="server" bindtap="editServer">服务器：{{server}}</view>
    <view class="server" bindtap="diagnose" style="color:#2E6BE6">网络诊断</view>
  </view>

  <view class="foot">账号由矿上管理员分配，忘记口令请联系安全科</view>
</view>
