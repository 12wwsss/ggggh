.page {
  min-height: 100vh;
  background: #f2ece0;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}
.brand { text-align: center; margin-bottom: 60rpx; }
.seal {
  width: 96rpx; height: 96rpx; line-height: 96rpx;
  margin: 0 auto 24rpx;
  background: #a5311f; color: #f7f1e6;
  font-size: 44rpx; border-radius: 6rpx;
}
.title { font-size: 40rpx; font-weight: 600; color: #1d1a15; letter-spacing: 4rpx; }
.sub { font-size: 24rpx; color: #6b6357; margin-top: 8rpx; }
.card { background: #fffdf8; border: 2rpx solid #d9d0bf; border-radius: 4rpx; padding: 40rpx 32rpx; }
.hint { font-size: 28rpx; color: #3c352b; margin-bottom: 28rpx; }
.input {
  height: 88rpx; border: 2rpx solid #d9d0bf; border-radius: 4rpx;
  padding: 0 20rpx; margin-bottom: 24rpx; background: #fff;
  font-size: 30rpx;
}
.btn {
  height: 88rpx; line-height: 88rpx; background: #a5311f; color: #fff;
  font-size: 32rpx; border-radius: 4rpx;
}
.error { margin-top: 28rpx; color: #a5311f; font-size: 26rpx; text-align: center; }
