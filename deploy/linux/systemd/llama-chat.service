[Unit]
Description=llama.cpp chat server (OpenAI compatible)
After=network-online.target

[Service]
Type=simple
User=coalrag
Group=coalrag
# -ngl 99 有 GPU 时开；纯 CPU 用 -ngl 0 并把 -t 调到物理核数
ExecStart=/opt/llama/llama-server \
  -m /opt/models/qwen2.5-7b-instruct-q4_k_m.gguf \
  --host 127.0.0.1 --port 8001 \
  -c 8192 -t 20 -ngl 0 --jinja
Restart=always
RestartSec=5
LimitNOFILE=65535
Nice=-5

[Install]
WantedBy=multi-user.target
