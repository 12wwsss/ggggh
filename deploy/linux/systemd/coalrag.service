[Unit]
Description=CoalRAG API server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=coalrag
Group=coalrag
WorkingDirectory=/opt/coalrag
EnvironmentFile=/etc/coalrag/coalrag.env
ExecStart=/opt/coalrag/bin/coalrag-server
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
