[Unit]
Description=llama.cpp embeddings server (bge-m3)
After=network-online.target

[Service]
Type=simple
User=coalrag
Group=coalrag
# bge-m3 必须用 cls 池化，维度 1024
ExecStart=/opt/llama/llama-server \
  -m /opt/models/bge-m3-q8_0.gguf \
  --host 127.0.0.1 --port 8002 \
  --embeddings --pooling cls -c 512 -t 10
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
