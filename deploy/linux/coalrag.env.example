# 复制到 /etc/coalrag/coalrag.env，改掉所有 CHANGE_ME
COALRAG_HTTP_ADDR=127.0.0.1:8080
COALRAG_DSN=postgres://coalrag:CHANGE_ME@127.0.0.1:5432/coalrag?sslmode=disable
COALRAG_JWT_SECRET=CHANGE_ME_LONG_RANDOM
COALRAG_STORAGE_DIR=/opt/coalrag/storage
COALRAG_LOG_LEVEL=info
COALRAG_BOOTSTRAP=true

# 对话模型（llama.cpp 的 OpenAI 兼容接口）
COALRAG_LLM_PROVIDER=openai
COALRAG_LLM_BASE_URL=http://127.0.0.1:8001/v1
COALRAG_LLM_MODEL=qwen2.5-7b-instruct
COALRAG_LLM_TIMEOUT=180s
COALRAG_LLM_MAX_TOKENS=512

# 嵌入模型（bge-m3，1024 维，池化方式必须是 cls）
COALRAG_EMBED_PROVIDER=openai
COALRAG_EMBED_BASE_URL=http://127.0.0.1:8002/v1
COALRAG_EMBED_MODEL=bge-m3
COALRAG_EMBED_DIM=1024

# 真实嵌入下必须重新标定，0.35 是起点
COALRAG_MIN_SCORE=0.35
COALRAG_TOP_K=6
COALRAG_HYBRID=true

# 只允许矿内网段（可选）
# COALRAG_ALLOWED_CIDRS=10.20.0.0/16
