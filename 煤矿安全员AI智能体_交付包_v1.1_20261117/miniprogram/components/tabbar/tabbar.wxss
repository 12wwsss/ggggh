.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 2rpx solid #ECEBE4;
  padding-top: 12rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 90;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 10rpx;
}
.tab-ico { width: 48rpx; height: 48rpx; }
.tab-lb { font-size: 20rpx; color: #9AA8B6; margin-top: 6rpx; }
.tab-lb.on { color: #A97900; font-weight: 700; }
