.doc { padding: 32rpx; margin-top: 24rpx; margin-bottom: 20rpx; }
.bar { height: 12rpx; border-radius: 6rpx; background: #ECEBE4; margin-top: 26rpx; overflow: hidden; }
.bar-in { height: 12rpx; border-radius: 6rpx; background: #FFC400; }
.tag {
  font-size: 21rpx; color: #A97900; background: #FFF3C4;
  padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 700;
}

.detail { margin-top: 26rpx; padding-top: 24rpx; border-top: 2rpx solid #F2F5F8; }
.dt-label { font-size: 21rpx; color: #98A2AC; font-weight: 700; margin: 18rpx 0 10rpx; }
.dt-text { font-size: 25rpx; color: #59636E; line-height: 42rpx; margin-bottom: 8rpx; }

.pt { display: flex; margin-bottom: 12rpx; }
.pt-num {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: #FFF3C4; color: #A97900;
  font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 14rpx; flex: none; margin-top: 4rpx;
}
.pt-txt { font-size: 25rpx; color: #242B32; line-height: 40rpx; flex: 1; }

.teams { margin-top: 10rpx; }
.team { display: flex; align-items: center; margin-top: 16rpx; }
.team-name { font-size: 23rpx; color: #59636E; width: 130rpx; }
.track { flex: 1; height: 12rpx; border-radius: 6rpx; background: #ECEBE4; margin: 0 18rpx; overflow: hidden; }
.track-in { height: 12rpx; border-radius: 6rpx; background: #FFC400; }

.btn-mini {
  margin-top: 28rpx; height: 84rpx; border-radius: 42rpx;
  background: #FFC400; color: #141A21; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

.stat { padding: 28rpx; margin-top: 8rpx; }
.stat-num { font-size: 46rpx; font-weight: 700; color: #12B76A; line-height: 50rpx; }

.tip { text-align: center; color: #98A2AC; font-size: 24rpx; padding: 60rpx 0; }
.err { padding: 30rpx; margin-top: 24rpx; }
.retry {
  display: inline-block; margin-top: 18rpx;
  background: #FFC400; color: #141A21; font-size: 24rpx;
  padding: 12rpx 32rpx; border-radius: 28rpx;
}
