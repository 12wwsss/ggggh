.page {
  min-height: 100vh;
  background: linear-gradient(170deg, #10151A 0%, #16273B 42%, #F3F2ED 42%, #F3F2ED 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 44rpx;
}

.brand { text-align: center; padding-top: 150rpx; }
.logo {
  width: 120rpx; height: 120rpx; border-radius: 32rpx;
  background: #FFC400; color: #141A21;
  font-size: 54rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(255,196,0,.35);
}
.title { color: #fff; font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.sub { color: #8FA3B8; font-size: 24rpx; margin-top: 14rpx; }

.panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 34rpx;
  margin-top: 78rpx;
  box-shadow: 0 10rpx 40rpx rgba(15,27,42,.08);
}

.benefit { margin-bottom: 34rpx; }
.b-item {
  display: flex; align-items: flex-start;
  font-size: 24rpx; color: #59636E; line-height: 38rpx;
  margin-bottom: 16rpx;
}
.dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #12B76A; margin: 14rpx 14rpx 0 0; flex: none;
}

.wx-login {
  width: 100%; height: 96rpx; line-height: 96rpx;
  border-radius: 48rpx; border: none; padding: 0;
  background: #07C160; color: #fff;
  font-size: 31rpx; font-weight: 700;
  box-shadow: 0 10rpx 26rpx rgba(7,193,96,.28);
}
.wx-login::after { border: none; }

.err { margin-top: 20rpx; font-size: 23rpx; color: #E5484D; text-align: center; }
.tip { margin-top: 10rpx; font-size: 22rpx; color: #98A2AC; text-align: center; line-height: 34rpx; }

.local {
  margin-top: 26rpx; text-align: center;
  font-size: 24rpx; color: #8090A0;
}

.foot {
  position: fixed; bottom: 46rpx; left: 0; right: 0;
  text-align: center; font-size: 20rpx; color: #A8B2BC;
  padding: 0 60rpx; line-height: 32rpx;
}
