<view class="page">
  <scroll-view class="cats" scroll-x="{{true}}">
    <text class="cat {{cat === '' ? 'cat-on' : ''}}" data-c="" bindtap="pickCat">全部</text>
    <text class="cat {{cat === item ? 'cat-on' : ''}}" wx:for="{{cats}}" wx:key="*this"
          data-c="{{item}}" bindtap="pickCat">{{item}}</text>
  </scroll-view>

  <view class="wrap">
    <view wx:if="{{loading}}" class="tip">正在加载…</view>

    <view wx:if="{{err}}" class="card err">
      <view class="small bold" style="color:#E5484D">内容没加载出来</view>
      <view class="tiny muted" style="margin-top:8rpx">{{err}}</view>
      <text class="retry" bindtap="retry">重试</text>
    </view>

    <block wx:if="{{!loading && !err}}">
      <view class="card item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <view class="cover cover-{{item.cover}}">
          <text class="cover-txt">{{item.cat}}</text>
        </view>
        <view class="grow">
          <view class="title">{{item.title}}</view>
          <view class="summary">{{item.summary}}</view>
          <view class="meta">
            <text>{{item.date}}</text>
            <text class="dot">·</text>
            <text>{{item.minutes}} 分钟</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!items.length}}" class="tip">这个分类还没有内容</view>
    </block>
  </view>
</view>
